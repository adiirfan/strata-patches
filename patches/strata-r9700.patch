+#if STRATA_NAT_W12
+    constexpr int NS = D_ROWS_K / 64;
+    constexpr int NFB = 2560 / NW_ROWS;
+    constexpr int ACT_LD = NS * AB;
+    constexpr int BS = block_bytes(WT);
