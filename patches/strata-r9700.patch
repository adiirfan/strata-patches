+        if (tid < 2 * kTileRows) {
+            const int r = tid >> 1, hh = tid & 1;
+            if (r < nrows) {
+                float am = 0.0f;
+#pragma unroll 8
+                for (int j = 0; j < 32; ++j) am = fmaxf(am, fabsf(hs[r][32 * hh + j]));
+                const float iv = am > 0.0f ? 127.0f / am : 0.0f;
