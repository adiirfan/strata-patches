+                        for (int nt = 0; nt < 2; ++nt)
+                            t[nt] = nw_wmma_f8(A1, nw_v(bq[nt][2 * h + 1]), nw_wmma_f8(A0, nw_v(bq[nt][2 * h]), t[nt]));
