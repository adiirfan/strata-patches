+__device__ __forceinline__ nw_f8 nw_wmma_f8(nw_ab a, nw_ab b, nw_f8 c) {
+    return __builtin_amdgcn_wmma_f32_16x16x16_fp8_fp8_w32_gfx12(a, b, c);
