+#!/bin/bash
+# dab.sh <rounds> <tokens file> "<label>|<K=V K=V>|<extra args>" ... : alternate engine settings, MAX_NEW tokens each,
+# print writing speed, drafts, and a hash of the output tokens (same hash = same words)
+cd ~/Strata
+n=$1; tf=$2; shift 2
+for r in $(seq 1 $n); do
+  for spec in "$@"; do
+    IFS='|' read -r label envs extra <<< "$spec"
+    STRATA_ENV_EXTRA="$envs" MAX_NEW=${MAX_NEW:-256} timeout 300 flock ~/gpu.lock .venv/bin/python engine_once.py $tf $extra > /tmp/dab.log 2>&1
+    dec=$(grep -oE "^decode .*-> +[0-9.]+ tok/s" /tmp/dab.log | grep -oE "[0-9.]+ tok/s")
+    acc=$(grep -oE "drafts accepted [0-9]+ of [0-9]+ \([0-9.]+\), [0-9.]+ tokens per round" /tmp/dab.log | head -1)
+    mtp=$(grep -oE "^mtp +[0-9.]+ ms/round" /tmp/dab.log | grep -oE "[0-9.]+ ms")
+    h=$(grep "^output" /tmp/dab.log | md5sum | cut -c1-8)
+    printf "%-10s %-12s %s | mtp %s | out %s\n" "$label" "$dec" "$acc" "$mtp" "$h"
+    [ -z "$dec" ] && tail -5 /tmp/dab.log
+  done
+done
diff --git a/tools/gfx1150/draft_vocab_cut.py b/tools/gfx1150/draft_vocab_cut.py
new file mode 100644
index 0000000..bec800a
--- /dev/null
+++ b/tools/gfx1150/draft_vocab_cut.py
@@ -0,0 +1,33 @@
+"""Cut the MTP draft head's token subset to the low token ids (tools/gfx1150/draft_vocab_cut.py).
+
+    python tools/gfx1150/draft_vocab_cut.py <mtp>/draft_vocab.bin out.bin [--below 80000] [--from 247900]
+
+Keeps, in their original order, the ids of the subset below --below (the tokenizer's earlier, more frequent merges)
+plus the special tokens from --from up. Pass the result as --mtp-draft-vocab out.bin.
+
+The draft head only proposes tokens, so the output is unchanged either way; a smaller subset makes each draft
+step cheaper. Text in scripts the cut drops (most CJK, Cyrillic) drafts less.
+"""
+from __future__ import annotations
+
+import argparse
+from array import array
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("src")
+    ap.add_argument("out")
+    ap.add_argument("--below", type=int, default=80000)
+    ap.add_argument("--from", dest="from_id", type=int, default=247900)
+    a = ap.parse_args()
+    ids = array("i")
+    ids.frombytes(open(a.src, "rb").read())
+    keep = array("i", [i for i in ids if i < a.below or i >= a.from_id])
+    open(a.out, "wb").write(keep.tobytes())
+    print(f"{len(keep)} of {len(ids)} tokens kept -> {a.out}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/gfx1150/drounds.py b/tools/gfx1150/drounds.py
new file mode 100644
index 0000000..2909106
--- /dev/null
+++ b/tools/gfx1150/drounds.py
@@ -0,0 +1,28 @@
+# drounds.py <kernel_trace.csv>: split the writing window into rounds (at mtp_select_kernel), per round: the verify
+# window size T (from gr_down_staged_kernel<T>), wall time, verify and draft parts
+import csv, sys, re, collections, statistics
+rows = list(csv.DictReader(open(sys.argv[1])))
+ts = lambda r: int(r["Start_Timestamp"]); te = lambda r: int(r["End_Timestamp"])
+rows.sort(key=ts)
+pf = [r for r in rows if "native_w11" in r["Kernel_Name"] or "prefill" in r["Kernel_Name"]]
+p1 = max(map(te, pf)) + 300_000_000
+win = [r for r in rows if ts(r) > p1]
+# a round: from the first kernel after an mtp_select_kernel to the next mtp_select_kernel
+cuts = [i for i, r in enumerate(win) if "mtp_select_kernel" in r["Kernel_Name"]]
+by = collections.defaultdict(list)
+for a, b in zip(cuts, cuts[1:]):
+    seg = win[a + 1:b + 1]
+    Ts = [int(m.group(1)) for r in seg for m in [re.search(r"gr_down_staged_kernel<(\d)", r["Kernel_Name"])] if m]
+    if not Ts: continue
+    T = max(set(Ts), key=Ts.count)
+    # draft part: from the first MTP kernel (heuristic: the first kernel after the last gr_* of the main pass whose
+    # name has mtp / draft) - use the last 'combine' of the main model instead: kernels after the head's top-k
+    wall = (te(seg[-1]) - ts(seg[0])) / 1e6
+    busy = sum(te(r) - ts(r) for r in seg) / 1e6
+    n = len(seg)
+    by[T].append((wall, busy, n))
+for T in sorted(by):
+    v = by[T]
+    print("T=%d rounds %3d | wall %.1f ms (median %.1f) | GPU busy %.1f ms | %d kernels" % (
+        T, len(v), statistics.mean(x[0] for x in v), statistics.median(x[0] for x in v),
+        statistics.mean(x[1] for x in v), statistics.mean(x[2] for x in v)))
