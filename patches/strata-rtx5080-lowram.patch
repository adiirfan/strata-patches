new file mode 100755
index 0000000..3f81232
--- /dev/null
+++ b/tools/rtx5080/eo5080.sh
@@ -0,0 +1,12 @@
+#!/bin/bash
+# tools/rtx5080/eo5080.sh <cap|none> <config> <tokens file> [K=V ...] [-- engine args]: the config's engine once on a
+# token file (eo5080.py) under a RAM cap, the file cache dropped first where `sudo -n` may; the engine's output goes to
+# /tmp/eo5080.log, ending with the run's peak memory (file cache included)
+cd "$(dirname "$0")/../.."
+CAP=$1; shift
+sync; echo 3 | sudo -n tee /proc/sys/vm/drop_caches >/dev/null 2>&1 || echo "note: the file cache was not dropped (sudo -n)"
+CAPARGS=(); [ "$CAP" != none ] && CAPARGS=(-p MemoryMax=$CAP -p MemorySwapMax=0)
+systemd-run --user --scope -q -p MemoryAccounting=yes "${CAPARGS[@]}" bash -c \
+  '.venv/bin/python tools/rtx5080/eo5080.py "$@"; echo "memory peak $(( $(cat /sys/fs/cgroup$(cut -d: -f3 /proc/self/cgroup)/memory.peak) / 1048576 )) MiB"' \
+  _ "$@" > /tmp/eo5080.log 2>&1
+grep -E "^prefill |^decode |^memory peak" /tmp/eo5080.log | cut -c1-200
diff --git a/tools/rtx5080/expert_mirror.py b/tools/rtx5080/expert_mirror.py
new file mode 100755
index 0000000..8be4518
--- /dev/null
+++ b/tools/rtx5080/expert_mirror.py
@@ -0,0 +1,122 @@
+#!/usr/bin/env python3
+"""Make a copy of a GGUF shard's experts on a second drive, for STRATA_EXPERT_MIRROR.
+
+    expert_mirror.py <shard.gguf> <copy> [--share 0.63]
+
+The engine's direct reads (STRATA_PROMPT_DIRECT=1, or an unbuffered file tier) take experts n - round(n * share) and
+up of every layer from the copy, so the copy only needs those.  This writes a file the size of the shard with just
+those byte ranges filled in (the rest is left as holes, which take no space): about `share` of the expert bytes.
+Build it with the same --share the engine runs with, or a larger one; the engine checks the copy at start and refuses
+one that lacks the experts it would read from it.  --share 1 copies every expert.
+"""
+import argparse
+import math
+import os
+import re
+import struct
+import sys
+import time
+
+EXPERT = re.compile(r"^blk\.\d+\.ffn_(gate|up|down|gate_up)_exps\.weight$")
+SCALAR = {0: "B", 1: "b", 2: "H", 3: "h", 4: "I", 5: "i", 6: "f", 7: "?", 10: "Q", 11: "q", 12: "d"}
+
+
+def read_tensors(path):
+    """(data offset, alignment, [(name, dims, offset in data)]) of a GGUF file (v2/v3)."""
+    with open(path, "rb") as f:
+        def take(fmt):
+            n = struct.calcsize("<" + fmt)
+            return struct.unpack("<" + fmt, f.read(n))
+
+        def string():
+            (n,) = take("Q")
+            return f.read(n).decode("utf-8", "replace")
+
+        def skip(t):
+            if t in SCALAR:
+                f.seek(struct.calcsize("<" + SCALAR[t]), 1)
+            elif t == 8:
+                (n,) = take("Q")
+                f.seek(n, 1)
+            elif t == 9:
+                et, n = take("IQ")
+                if et in SCALAR:
+                    f.seek(n * struct.calcsize("<" + SCALAR[et]), 1)
+                else:
+                    for _ in range(n):
+                        skip(et)
+            else:
+                sys.exit(f"{path}: unknown GGUF value type {t}")
+
+        if f.read(4) != b"GGUF":
+            sys.exit(f"{path}: not a GGUF file")
+        version, n_tensors, n_kv = take("IQQ")
+        if version < 2:
+            sys.exit(f"{path}: GGUF version {version} is too old")
+        align = 32
+        for _ in range(n_kv):
+            key = string()
+            (t,) = take("I")
+            if key == "general.alignment" and t == 4:
+                (align,) = take("I")
+            else:
+                skip(t)
+        tensors = []
+        for _ in range(n_tensors):
+            name = string()
+            (nd,) = take("I")
+            dims = take("Q" * nd)
+            _, off = take("IQ")
+            tensors.append((name, dims, off))
+        data = (f.tell() + align - 1) // align * align
+    return data, align, tensors
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
+    ap.add_argument("shard")
+    ap.add_argument("copy")
+    ap.add_argument("--share", type=float, default=0.5, help="the STRATA_EXPERT_MIRROR_SHARE it is for (default 0.5)")
+    a = ap.parse_args()
+    share = min(max(a.share, 0.0), 1.0)
+    size = os.path.getsize(a.shard)
+    data, align, tensors = read_tensors(a.shard)
+    ends = sorted(off for _, _, off in tensors) + [size - data]
+    ranges = []
+    for name, dims, off in tensors:
+        if not EXPERT.match(name):
+            continue
+        n = dims[-1]
+        span = min(e for e in ends if e > off) - off
+        per = span // n
+        if span - per * n >= align:
+            sys.exit(f"{name}: {span} bytes do not split into {n} experts")
+        cut = n - math.floor(n * share + 0.5)
+        if cut < n:
+            ranges.append((data + off + cut * per, (n - cut) * per))
+    if not ranges:
+        sys.exit(f"{a.shard}: no expert tensors (blk.N.ffn_*_exps.weight)")
+    total = sum(b for _, b in ranges)
+    print(f"{len(ranges)} expert ranges, {total / 1e9:.2f} GB of {size / 1e9:.2f} GB", flush=True)
+    t0 = time.time()
+    buf = bytearray(64 << 20)
+    with open(a.shard, "rb", buffering=0) as src, open(a.copy, "r+b" if os.path.exists(a.copy) else "w+b", buffering=0) as dst:
+        os.ftruncate(dst.fileno(), size)
+        done = 0
+        for at, n in sorted(ranges):
+            src.seek(at)
+            dst.seek(at)
+            while n > 0:
+                k = src.readinto(memoryview(buf)[: min(n, len(buf))])
+                if not k:
+                    sys.exit(f"{a.shard}: short read at {at}")
+                dst.write(memoryview(buf)[:k])
+                n -= k
+                done += k
+            print(f"\r{done / 1e9:7.2f} / {total / 1e9:.2f} GB  {done / 1e9 / max(time.time() - t0, 1e-3):.2f} GB/s", end="", flush=True)
+        os.fsync(dst.fileno())
+    print(f"\ndone: STRATA_EXPERT_MIRROR={os.path.abspath(a.copy)} STRATA_EXPERT_MIRROR_SHARE={share:g} (or less)")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/rtx5080/expert_pack.py b/tools/rtx5080/expert_pack.py
new file mode 100644
index 0000000..bf870d2
--- /dev/null
+++ b/tools/rtx5080/expert_pack.py
@@ -0,0 +1,105 @@
+#!/usr/bin/env python3
+"""Write a GGUF shard's experts to a second drive as whole blobs, for STRATA_EXPERT_MIRROR.
+
+    expert_pack.py <shard.gguf> <out> [--share 0.75]
+
+The engine assembles each expert as one blob - its gate, up and down slices, in that order - out of three scattered
+slices of the shard. This file stores experts n - round(n * share) .. n-1 of every layer as such blobs, each starting
+on a 4 KiB boundary, so the engine reads a blob from it in one request. QLC drives serve one 2 MB request faster than
+three scattered 0.7 MB ones. Give the file to the engine as STRATA_EXPERT_MIRROR (it tells this layout from a plain
+copy by its header) with STRATA_EXPERT_MIRROR_SHARE / _DECODE_SHARE at or below the share it was written with.
+
+Layout: a 4 KiB-aligned header - "STRPACK1", u32 version (1), n_layers, n_expert, first expert, u64 shard size, then
+per layer u64 blob bytes, stride (blob bytes rounded up to 4 KiB) and the file offset of the layer's first blob.
+"""
+import argparse
+import math
+import os
+import re
+import struct
+import sys
+import time
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from expert_mirror import read_tensors  # noqa: E402
+
+ROLE = re.compile(r"^blk\.(\d+)\.ffn_(gate|up|down)_exps\.weight$")
+A = 4096
+
+
+def up4k(x):
+    return (x + A - 1) // A * A
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
+    ap.add_argument("shard")
+    ap.add_argument("out")
+    ap.add_argument("--share", type=float, default=0.75)
+    a = ap.parse_args()
+    size = os.path.getsize(a.shard)
+    data, align, tensors = read_tensors(a.shard)
+    ends = sorted(off for _, _, off in tensors) + [size - data]
+    layers, n_expert = {}, None
+    for name, dims, off in tensors:
+        m = ROLE.match(name)
+        if not m:
+            continue
+        n = dims[-1]
+        n_expert = n if n_expert is None else n_expert
+        if n != n_expert:
+            sys.exit(f"{name}: {n} experts, others have {n_expert}")
+        span = min(e for e in ends if e > off) - off
+        per = span // n
+        if span - per * n >= align:
+            sys.exit(f"{name}: {span} bytes do not split into {n} experts")
+        layers.setdefault(int(m.group(1)), {})[m.group(2)] = (data + off, per)
+    if not layers or any(len(r) != 3 for r in layers.values()):
+        sys.exit(f"{a.shard}: every layer needs ffn_gate_exps, ffn_up_exps and ffn_down_exps in this shard")
+    n_layers = max(layers) + 1
+    if sorted(layers) != list(range(n_layers)):
+        sys.exit(f"{a.shard}: layers {sorted(set(range(n_layers)) - set(layers))} have no experts here")
+    first = n_expert - math.floor(n_expert * min(max(a.share, 0.0), 1.0) + 0.5)
+    count = n_expert - first
+    head = 8 + 4 * 4 + 8 + n_layers * 24
+    at = up4k(head)
+    table = []
+    for L in range(n_layers):
+        blob = sum(layers[L][r][1] for r in ("gate", "up", "down"))
+        table.append((blob, up4k(blob), at))
+        at += up4k(blob) * count
+    total = at
+    print(f"{n_layers} layers, experts {first}..{n_expert - 1}: {total / 1e9:.2f} GB", flush=True)
+    hdr = b"STRPACK1" + struct.pack("<IIII", 1, n_layers, n_expert, first) + struct.pack("<Q", size)
+    for blob, stride, off in table:
+        hdr += struct.pack("<QQQ", blob, stride, off)
+    t0 = time.time()
+    with open(a.shard, "rb", buffering=0) as src, open(a.out, "wb", buffering=0) as dst:
+        dst.write(hdr + bytes(up4k(len(hdr)) - len(hdr)))
+        for L in range(n_layers):
+            blob, stride, off = table[L]
+            parts = []
+            for r in ("gate", "up", "down"):
+                o, per = layers[L][r]
+                src.seek(o + first * per)
+                buf = src.read(per * count)
+                if len(buf) != per * count:
+                    sys.exit(f"{a.shard}: short read in layer {L}")
+                parts.append((buf, per))
+            out = bytearray(stride * count)
+            for i in range(count):
+                p = i * stride
+                for buf, per in parts:
+                    out[p:p + per] = buf[i * per:(i + 1) * per]
+                    p += per
+            if dst.tell() != off:
+                sys.exit(f"layer {L}: at {dst.tell()}, expected {off}")
+            dst.write(out)
+            print(f"\rlayer {L + 1}/{n_layers}  {dst.tell() / 1e9:.2f} GB  {dst.tell() / 1e9 / max(time.time() - t0, 1e-3):.2f} GB/s",
+                  end="", flush=True)
+        os.fsync(dst.fileno())
+    print(f"\ndone: STRATA_EXPERT_MIRROR={os.path.abspath(a.out)} (shares up to {count / n_expert:g})")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/rtx5080/lbench.py b/tools/rtx5080/lbench.py
new file mode 100644
index 0000000..a14f5a1
--- /dev/null
+++ b/tools/rtx5080/lbench.py
@@ -0,0 +1,47 @@
+# tools/rtx5080/lbench.py <out.json> <target tokens,...> [rounds]: against the running server - for each target, a
+# fresh prompt of about that many tokens (a unique first line, then text from LBENCH_CORPUS, a large text file)
+# ending in a writing request; records the prompt rate, the writing rate of a 256-token answer, and the engine's own
+# line for the request from its log (LBENCH_LOG, the config's "log")
+import json, os, random, sys, time, urllib.request, re
+os.chdir(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", ".."))
+out, targets = sys.argv[1], [int(x) for x in sys.argv[2].split(",")]
+rounds = int(sys.argv[3]) if len(sys.argv) > 3 else 1
+corpus = open(os.environ["LBENCH_CORPUS"], errors="replace").read()
+log = os.environ.get("LBENCH_LOG", "strata-5080-iq3s.log")
+TASK = "\n\n---\nIgnore the text above. Write a long story about a lighthouse keeper who finds a message in a bottle."
+def ask(text, n):
+    body = {"model": "x", "messages": [{"role": "user", "content": text}], "max_tokens": n, "reasoning_effort": "none",
+            "temperature": 0}
+    r = urllib.request.Request("http://127.0.0.1:8080/v1/chat/completions", json.dumps(body).encode(),
+                               {"Content-Type": "application/json"})
+    return json.load(urllib.request.urlopen(r, timeout=3600))
+def last_engine_line():
+    if not os.path.exists(log): return ""
+    lines = [l for l in open(log, errors="replace") if l.startswith("strata serve: prompt ")]
+    return lines[-1].strip() if lines else ""
+ratio = 3.3   # characters per token, corrected after every request
+results = json.load(open(out)) if os.path.exists(out) else []
+ask("Say hello.", 8)
+for rd in range(rounds):
+    for tgt in targets:
+        for attempt in range(3):
+            head = "Note %d.\n\n" % random.randint(0, 10**12)
+            nchar = int((tgt - 60) * ratio)
+            if nchar > len(corpus): sys.exit("LBENCH_CORPUS has %d characters; %d tokens need about %d" % (len(corpus), tgt, nchar))
+            start = random.randint(0, max(0, len(corpus) - nchar - 1)) if rd > 0 else 0
+            text = head + corpus[start:start + nchar] + TASK
+            t0 = time.time()
+            d = ask(text, 256)
+            tm = d["timings"]
+            ratio = nchar / max(1, tm["prompt_n"] - 60)
+            if abs(tm["prompt_n"] - tgt) <= max(256, tgt * 0.03) or attempt == 2: break
+            print("  resize: asked %d, got %d tokens (ratio now %.3f)" % (tgt, tm["prompt_n"], ratio), flush=True)
+        line = last_engine_line()
+        m = re.search(r"drafts accepted (\d+) of (\d+)", line)
+        r = {"target": tgt, "round": rd, "prompt_n": tm["prompt_n"], "prompt_tps": tm["prompt_per_second"],
+             "prompt_s": tm["prompt_ms"] / 1000, "gen_n": tm["predicted_n"], "gen_tps": tm["predicted_per_second"],
+             "drafts": [int(m.group(1)), int(m.group(2))] if m else None, "wall_s": time.time() - t0, "engine": line}
+        results.append(r)
+        json.dump(results, open(out, "w"), indent=1)
+        print("%6dK r%d  prompt %7d tok in %6.1f s = %5.1f tok/s | writing %3d tok at %5.2f tok/s | drafts %s" % (
+            tgt // 1024, rd, r["prompt_n"], r["prompt_s"], r["prompt_tps"], r["gen_n"], r["gen_tps"], r["drafts"]), flush=True)
diff --git a/tools/rtx5080/lp5080.py b/tools/rtx5080/lp5080.py
new file mode 100644
index 0000000..f271b8a
--- /dev/null
+++ b/tools/rtx5080/lp5080.py
@@ -0,0 +1,41 @@
+# tools/rtx5080/lp5080.py <label> [K=V ...]: the low-RAM server (srv5080.sh, LP_CAP, default 8G) reads a conversation
+# through its writing path (--short-read, adaptive tier off) and writes every position's log-probabilities to
+# /tmp/lp_<label>.tsv; compare two such files with lp_cmp.py.  LP_CFG: the config (default
+# tools/rtx5080/strata-5080-lowram-iq3s.json); LP_MSGS=<json>: the conversation (default /tmp/lp_ref_story.json);
+# LP_GEN=1: write the reference conversations instead (/tmp/lp_ref_story.json, /tmp/lp_ref_code.json: the model's own
+# 300-token answers to a story and a code request, with these settings)
+import json, os, subprocess, sys, urllib.request
+os.chdir(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", ".."))
+SRV = "tools/rtx5080/srv5080.sh"
+label, pairs = sys.argv[1], sys.argv[2:]
