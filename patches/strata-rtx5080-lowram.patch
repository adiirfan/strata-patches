index 0000000..03be250
--- /dev/null
+++ b/tools/rtx5080/run-5080-lowram.sh
@@ -0,0 +1,13 @@
+#!/bin/sh
+# Strata on an RTX 5080 Laptop with little RAM (Qwen3.8-Flash-Next abliterated IQ3_S): the OpenAI-compatible server on
+# 127.0.0.1:8080.  The experts the GPU does not hold are read from two SSDs as needed: the model's own, and a packed
+# copy of most of each layer's experts on a second drive (tools/rtx5080/expert_pack.py, STRATA_EXPERT_MIRROR in the
+# config).  RAM - the engine, its expert cache and the file cache - is capped at ${STRATA_RAM:-8G}, swap off; with more
+# RAM raise the config's STRATA_STAGE_KEEP too (about 490 experts per extra GB).  STRATA_EXPERT_SKIP=0.1 writes faster
+# by leaving out light experts that are not at hand (slightly different answers; off unless set).  --kv-grow lends
+# the graphics memory the K/V does not use yet to the expert cache, and two conversation checkpoints (--prompt-cache 2)
+# keep a long prompt inside the RAM cap.  The int8 K/V fits 163,840 tokens beside the prompt path's loan on a 16 GB
+# card (--max-context).  STRATA_CONFIG picks another config.
+cd "$(dirname "$0")/../.."
+exec systemd-run --user --scope -p MemoryMax=${STRATA_RAM:-8G} -p MemorySwapMax=0 \
+  .venv/bin/python serve/server.py --engine strata --config "${STRATA_CONFIG:-tools/rtx5080/strata-5080-lowram-iq3s.json}" --port 8080 "$@"
diff --git a/tools/rtx5080/srv5080.sh b/tools/rtx5080/srv5080.sh
new file mode 100755
index 0000000..2bae767
--- /dev/null
+++ b/tools/rtx5080/srv5080.sh
@@ -0,0 +1,23 @@
+#!/bin/bash
+# tools/rtx5080/srv5080.sh start <config> [MemoryMax e.g. 8G | none] | stop | mem
+# the Strata server as a transient user service (its own cgroup: RAM incl. page cache is accounted; an optional hard
+# cap with swap off), on 127.0.0.1:8080; start waits until it answers
+ROOT=$(cd "$(dirname "$0")/../.." && pwd)
+U=strata5080
+cg() { echo /sys/fs/cgroup$(systemctl --user show $U.service -p ControlGroup --value); }
+case "$1" in
+start)
+  systemctl --user stop $U.service 2>/dev/null; systemctl --user reset-failed $U.service 2>/dev/null
+  for i in $(seq 60); do (exec 3<>/dev/tcp/127.0.0.1/8080) 2>/dev/null || break; sleep 1; done
+  CAP=(); [ -n "$3" ] && [ "$3" != none ] && CAP=(-p MemoryMax=$3 -p MemorySwapMax=0)
+  systemd-run --user --unit=$U --collect -p MemoryAccounting=yes "${CAP[@]}" --working-directory="$ROOT" \
+    "$ROOT/.venv/bin/python" serve/server.py --engine strata --config "$2" --port 8080 >/dev/null 2>&1
+  for i in $(seq 200); do
+    curl -s -m 2 http://127.0.0.1:8080/v1/models >/dev/null && { echo "up ($(( $(cat $(cg)/memory.current) / 1048576 )) MiB now)"; exit 0; }
+    systemctl --user is-active -q $U.service || { echo "service stopped"; journalctl --user -u $U -n 15 --no-pager | cut -c1-200; exit 1; }
+    sleep 2
+  done; echo "not up";;
+stop) systemctl --user stop $U.service;;
+mem) C=$(cg); echo "current $(( $(cat $C/memory.current) / 1048576 )) MiB, peak $(( $(cat $C/memory.peak) / 1048576 )) MiB"
+     grep -E "^(anon|file|shmem|unevictable) " $C/memory.stat | awk '{printf "%s %d MiB  ", $1, $2/1048576} END {print ""}';;
+esac
